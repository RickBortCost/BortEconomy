{
  "name": "borteconomy",
  "version": "1.8.0",
  "private": true,
  "description": "News economiche, mercati mondiali e analisi AI con Claude",
  "type": "module",
  "scripts": {
    "data": "node scripts/fetch-data.mjs",
    "serve": "python3 -m http.server 8000 -d site",
    "release:patch": "node scripts/bump.mjs patch",
    "release:minor": "node scripts/bump.mjs minor",
    "release:major": "node scripts/bump.mjs major",
    "test": "node tests/unit.mjs && node tests/fixtures.mjs && node tests/smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0"
  }
}
